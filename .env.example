# Copy to .env and fill in. docker compose and tracepath both read it.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# At least 8 characters (Neo4j rejects shorter passwords).
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# The Anthropic API key extraction calls Claude with. Checked at startup, so a
# missing key fails before any work starts rather than at the first call.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me
# Optional. Defaults to the model spec 0001 chose, claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

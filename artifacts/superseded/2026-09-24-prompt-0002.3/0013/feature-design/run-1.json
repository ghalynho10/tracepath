    "entities": [
      {
        "id": "derived:1",
        "id_source": "derived",
        "type": "Feature",
        "span": "No new database table. Results are never persisted, so the only new shape is an in memory value object, Zod parsed at the Adzuna response boundary and never written to Postgres.",
        "rejected_spans": [
          "by product decision, recorded in `docs/scope/scope.md`'s Slice 1 introduction"
        ],
        "known_trap_flags": [
          "granularity_boundary_call"
        ],
        "unclassified_note": null,
        "label": "Listing"
      },
      {
        "id": "derived:2",
        "id_source": "derived",
        "type": "Feature",
        "span": "`SearchQuery` (parsed from URL search params, request scoped): `title` and `location`, each optional individually but at least one required, trimmed, max 200 characters, mapping to Adzuna's `what` and `where`.",
        "rejected_spans": [],
        "known_trap_flags": [
          "granularity_boundary_call"
        ],
        "unclassified_note": null,
        "label": "SearchQuery"
      },
      {
        "id": "derived:3",
        "id_source": "derived",
        "type": "Constraint",
        "span": "Exactly one Adzuna call, and exactly one usage gate check, per user submitted search, never zero and never more than one",
        "rejected_spans": [
          "so spec 0011's own accounting assumption (\"the cap counts outbound API calls\") holds exactly"
        ],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": "key invariant 1"
      },
      {
        "id": "derived:4",
        "id_source": "derived",
        "type": "Constraint",
        "span": "A usage gate refusal, or a blank query, always short circuits before any Adzuna call, enforced structurally by the `withUsageGate()` helper, never left to a caller remembering to check `allowed` first.",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": "key invariant 2"
      },
      {
        "id": "derived:5",
        "id_source": "derived",
        "type": "Constraint",
        "span": "Currency is never read from Adzuna; it is always the constant derived from the configured country.",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": "key invariant 3"
      },
      {
        "id": "derived:6",
        "id_source": "derived",
        "type": "Constraint",
        "span": "Attribution renders once per displayed listing, never once per screen. A screen with zero listings shows no attribution block",
        "rejected_spans": [
          "since there is nothing to attribute"
        ],
        "known_trap_flags": [
          "granularity_boundary_call"
        ],
        "unclassified_note": null,
        "label": "key invariant 4"
      },
      {
        "id": "derived:7",
        "id_source": "derived",
        "type": "Constraint",
        "span": "A predicted salary is never shown indistinguishably from a stated one.",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": "key invariant 5"
      },
      {
        "id": "derived:8",
        "id_source": "derived",
        "type": "Constraint",
        "span": "No listing data is ever written to the database by this feature. Every result is request scoped and re fetched on the next search.",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": "key invariant 6"
      },
      {
        "id": "derived:9",
        "id_source": "derived",
        "type": "Constraint",
        "span": "An optional field with no value (`location`, `descriptionSnippet`, either salary figure, `postedAt`) is simply omitted from the card, never rendered as a placeholder or a dash that could be mistaken for real data.",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": "key invariant 7"
      },
      {
        "id": "derived:10",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Happy path: a signed in user with a `job_preference` row searches with a real title, sees real Adzuna listings with working attribution and outbound links",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:11",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Failure case: Adzuna forced to time out and, separately, forced to return a malformed body, each renders the failure state and reports the matching kind",
        "rejected_spans": [],
        "known_trap_flags": [
          "multi_condition_split"
        ],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:12",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Failure case: Adzuna forced to return a non success HTTP status (e.g. a `429`), renders the same failure state and reports `external_service_failed`",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:13",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Failure case: a batch where one of several returned listings fails its own item level parse renders the rest normally and drops only the bad one",
        "rejected_spans": [
          "the \"every item fails\" branch is a separate case, same kind"
        ],
        "known_trap_flags": [
          "multi_condition_split"
        ],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:14",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Gate: a caller whose account week cap is already spent gets the exact `account_week_cap_reached` sentence and no Adzuna call runs",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:15",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Gate failure: `checkUsageGate()` itself forced to fail (an invalid session, or a forced database error) renders the failure state through `session_missing` or `database_unavailable` respectively, never the refusal state",
        "rejected_spans": [],
        "known_trap_flags": [
          "multi_condition_split"
        ],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:16",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Validation: a submission with both fields blank is refused before any call and spends no budget",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:17",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Empty: a search that legitimately matches nothing renders the empty state, distinguishable from both the failure and refusal states",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": null
      },
      {
        "id": "derived:18",
        "id_source": "derived",
        "type": "TestScenario",
        "span": "Predicted salary: a listing carrying `salary_is_predicted: true` renders the estimate label and the Jobsworth attribution; one carrying `false` (or no salary) renders neither",
        "rejected_spans": [],
        "known_trap_flags": [],
        "unclassified_note": null,
        "label": null
      },
      {

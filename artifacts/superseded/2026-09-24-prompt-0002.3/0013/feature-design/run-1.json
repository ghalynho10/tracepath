        "id_source": "derived",
        "type": "TestScenario",
        "span": "Prefill without spend: a caller with a `job_preference` row visits bare `/search` (no `q`/`where`), sees the fields prefilled, and neither `checkUsageGate()` nor the Adzuna client is called",
        "rejected_spans": [],
